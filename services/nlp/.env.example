# =============================================================================
# CivicPulse NLP Service — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Do NOT commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development                     # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- Model Paths ---
# Paths are relative to the services/nlp/ directory
MODEL_CLASSIFIER_PATH=models/classifier/v0.2.0
MODEL_EXTRACTOR_PATH=models/ner/v0.2.0
MODEL_EMBEDDER_PATH=models/embedder/v0.1.0

# --- Model Configuration ---
MODEL_VERSION=0.2.0

# --- Confidence Thresholds ---
CONFIDENCE_HIGH_THRESHOLD=0.7           # Above this = confident prediction
CONFIDENCE_LOW_THRESHOLD=0.4            # Below this = fallback to OTHER

# --- Input Constraints ---
MAX_INPUT_LENGTH=2000                   # Maximum characters per input text
MAX_SIMILARITY_TARGETS=50              # Maximum targets in similarity request

# --- CORS ---
# Comma-separated origins. Use * for development only.
CORS_ORIGINS=*
