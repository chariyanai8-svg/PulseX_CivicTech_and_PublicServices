{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The full original text"
    },
    "tokens": {
      "type": "array",
      "items": { "type": "string" },
      "description": "The text split into words/tokens"
    },
    "ner_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "O",
          "B-ISSUE", "I-ISSUE",
          "B-LOCATION", "I-LOCATION",
          "B-SEVERITY", "I-SEVERITY",
          "B-TIMING", "I-TIMING",
          "B-SYMPTOM", "I-SYMPTOM"
        ]
      },
      "description": "BIO scheme NER tags mapping 1:1 to tokens array"
    },
    "language": {
      "type": "string",
      "enum": ["en", "ms", "mixed"]
    },
    "source": {
      "type": "string",
      "enum": ["manual", "synthetic", "public"]
    }
  },
  "required": ["text", "tokens", "ner_tags", "language", "source"]
}
