{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The raw civic report text"
    },
    "category": {
      "type": "string",
      "enum": [
        "ROADS", "DRAINAGE", "WASTE", "LIGHTING", "FALLEN_TREES",
        "OBSTRUCTION", "FACILITIES", "PEDESTRIAN", "HAZARD", "ENVIRONMENT", "OTHER"
      ],
      "description": "The primary issue category"
    },
    "language": {
      "type": "string",
      "enum": ["en", "ms", "mixed"],
      "description": "The detected or labeled language of the text"
    },
    "source": {
      "type": "string",
      "enum": ["manual", "synthetic", "public"],
      "description": "The origin of the data point"
    },
    "reviewed": {
      "type": "boolean",
      "description": "Must be true for synthetic data before inclusion in the final dataset"
    }
  },
  "required": ["text", "category", "language", "source", "reviewed"]
}
