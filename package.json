{
  "name": "civicpulse-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,FRONTEND\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:admin\"",
    "dev:all": "concurrently -n \"SERVER,FRONTEND\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:admin\"",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:user": "npm run dev --workspace=apps/web-user",
    "dev:admin": "npm run dev --workspace=apps/web-admin"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
